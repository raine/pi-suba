#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/cua-common
source "$script_dir/lib/cua-common"

usage() {
  cat <<'EOF'
Usage: scripts/cua-reset <session>

Stop project tmux processes and clear artifacts, observed markers, and Pi
sessions while retaining the deployed package, fixtures, and credentials.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

session_name="$(require_session_name "${1:-}")"
container="$(session_container "$session_name")"
require_running_container "$container"
exec_user "$container" tmux kill-session -t "$container_tmux_session" 2>/dev/null || true
exec_user "$container" bash -lc "
  rm -rf '$container_artifact_root' /home/user/work/pi-suba-observed
  mkdir -p '$container_artifact_root' /home/user/work/pi-suba-observed
  rm -rf \"\$HOME/.pi/agent/sessions\"
"
echo "Reset pi-suba test state in $container"
