{
  "name": "pi-suba",
  "version": "0.1.0",
  "description": "Interactive tmux subagents for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs",
    "types": "tsgo --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc}\"",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc}\"",
    "test": "vitest run",
    "test:tmux": "vitest run test/tmux.test.ts",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "pi": {
    "extensions": [
      "./pi-suba.ts"
    ]
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^24.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260629.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typebox": "^1.3.7",
    "vitest": "^3.2.4"
  }
}
